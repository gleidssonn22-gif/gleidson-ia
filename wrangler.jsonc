{
  "name": "gleidson-ia",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/chat/*"
    ]
  },
  "routes": [
    {
      "pattern": "clubewins.com.br/chat/*",
      "zone_name": "clubewins.com.br"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "839271",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
